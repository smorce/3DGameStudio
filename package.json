{
  "name": "machine-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "concurrently -k 'pnpm dev:server' 'pnpm dev:studio'",
    "dev:studio": "vite apps/studio --host 0.0.0.0",
    "dev:player": "vite apps/player --host 0.0.0.0",
    "dev:server": "tsx apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm cycles",
    "cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "smoke": "playwright test --grep @smoke",
    "build": "vite build apps/studio && vite build apps/player && vite build --config apps/server/vite.config.ts",
    "test:providers": "tsx scripts/provider-smoke.ts",
    "start:server": "node apps/server/dist/index.js",
    "prepare:demos": "tsx scripts/prepare-demos.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "express": "^5.1.0",
    "meshoptimizer": "0.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.4",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.35.0",
    "madge": "^8.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
